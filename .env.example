# ==============================================================================
# UNIMIB Calendar - Configurazione Variabili d'Ambiente
# ==============================================================================
# Copia questo file in .env o .env.local per configurare le credenziali in locale.
# In produzione su Vercel, queste variabili vanno impostate nella dashboard del progetto.

# Upstash Redis (REST API)
# Necessario per la sincronizzazione cloud di profili, gruppi e calendari condivisi.
# Se non configurato, l'applicazione usa automaticamente un fallback locale temporaneo.
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token
